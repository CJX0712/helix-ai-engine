# Helix configuration. Override any value via environment variables; all keys
# are prefixed with HELIX_. Copy this file to .env and edit as needed.

# Provider mode: auto | openai | mock
#   auto   -> use the real provider, fall back to a local deterministic one if unreachable
#   openai -> always use the real provider (errors surface)
#   mock   -> always use the offline deterministic providers (no network)
HELIX_PROVIDER_MODE=auto

# LLM (any OpenAI-compatible endpoint, e.g. Ollama)
HELIX_LLM_BASE_URL=http://localhost:11434/v1
HELIX_LLM_API_KEY=ollama
HELIX_LLM_MODEL=qwen2.5:0.5b

# Embeddings (any OpenAI-compatible endpoint)
HELIX_EMBEDDING_BASE_URL=http://localhost:11434/v1
HELIX_EMBEDDING_API_KEY=ollama
HELIX_EMBEDDING_MODEL=nomic-embed-text

HELIX_VECTORSTORE_TYPE=memory
HELIX_TOP_K=4
HELIX_MAX_AGENT_ITERATIONS=6
HELIX_LOG_LEVEL=INFO
